{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "verbatimModuleSyntax": true
  },
  "include": ["src/renderer/src", "src/shared"],
  // The detector worker's globals conflict with the DOM lib; tsconfig.worker.json checks it.
  "exclude": ["src/renderer/src/paper/detector/worker.ts"]
}
