{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2023", "WebWorker"],
    "types": [],
    "verbatimModuleSyntax": true
  },
  // The worker's program: every detector module, by glob, so one added later is type-checked as
  // worker code too (ruling P3-R26). Not client.ts or breakout-box.d.ts, which are window code
  // (MediaStream, MediaStreamTrack, and a processor declaration the WebWorker lib already has).
  "include": ["src/renderer/src/paper/detector/**/*.ts", "src/renderer/src/paper/contracts.ts"],
  "exclude": [
    "src/renderer/src/paper/detector/client.ts",
    "src/renderer/src/paper/detector/breakout-box.d.ts"
  ]
}
