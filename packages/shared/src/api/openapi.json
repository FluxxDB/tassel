{
  "components": {
    "schemas": {
      "DeviceRegistration": {
        "properties": {
          "device_id": {
            "format": "uuid",
            "title": "Device Id",
            "type": "string"
          },
          "token": {
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "device_id",
          "token"
        ],
        "title": "DeviceRegistration",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthOut": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version"
        ],
        "title": "HealthOut",
        "type": "object"
      },
      "IceCandidateIn": {
        "properties": {
          "candidate": {
            "title": "Candidate",
            "type": "string"
          },
          "sdp_mid": {
            "title": "Sdp Mid",
            "type": "string"
          },
          "sdp_mline_index": {
            "title": "Sdp Mline Index",
            "type": "integer"
          }
        },
        "required": [
          "candidate",
          "sdp_mid",
          "sdp_mline_index"
        ],
        "title": "IceCandidateIn",
        "type": "object"
      },
      "IcePatch": {
        "properties": {
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/IceCandidateIn"
            },
            "title": "Candidates",
            "type": "array"
          },
          "pc_id": {
            "title": "Pc Id",
            "type": "string"
          }
        },
        "required": [
          "pc_id",
          "candidates"
        ],
        "title": "IcePatch",
        "type": "object"
      },
      "IceServerOut": {
        "properties": {
          "credential": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Credential"
          },
          "urls": {
            "items": {
              "type": "string"
            },
            "title": "Urls",
            "type": "array"
          },
          "username": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Username"
          }
        },
        "required": [
          "urls"
        ],
        "title": "IceServerOut",
        "type": "object"
      },
      "IceServersOut": {
        "properties": {
          "ice_servers": {
            "items": {
              "$ref": "#/components/schemas/IceServerOut"
            },
            "title": "Ice Servers",
            "type": "array"
          }
        },
        "required": [
          "ice_servers"
        ],
        "title": "IceServersOut",
        "type": "object"
      },
      "MeOut": {
        "properties": {
          "learner_id": {
            "format": "uuid",
            "title": "Learner Id",
            "type": "string"
          },
          "ui_language": {
            "enum": [
              "en",
              "es",
              "ko"
            ],
            "title": "Ui Language",
            "type": "string"
          }
        },
        "required": [
          "learner_id",
          "ui_language"
        ],
        "title": "MeOut",
        "type": "object"
      },
      "OfferAnswer": {
        "properties": {
          "pc_id": {
            "title": "Pc Id",
            "type": "string"
          },
          "sdp": {
            "title": "Sdp",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "sdp",
          "type",
          "pc_id"
        ],
        "title": "OfferAnswer",
        "type": "object"
      },
      "OfferBody": {
        "additionalProperties": false,
        "properties": {
          "pc_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pc Id"
          },
          "requestData": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/OfferRequestData"
              },
              {
                "type": "null"
              }
            ]
          },
          "restart_pc": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Restart Pc"
          },
          "sdp": {
            "title": "Sdp",
            "type": "string"
          },
          "type": {
            "const": "offer",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "sdp",
          "type"
        ],
        "title": "OfferBody",
        "type": "object"
      },
      "OfferRequestData": {
        "additionalProperties": false,
        "description": "The RTVI ``requestData`` of a voice offer.",
        "properties": {
          "ptt": {
            "default": false,
            "title": "Ptt",
            "type": "boolean"
          },
          "scenario": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scenario"
          },
          "sensitivity": {
            "default": "normal",
            "enum": [
              "low",
              "normal",
              "high"
            ],
            "title": "Sensitivity",
            "type": "string"
          }
        },
        "title": "OfferRequestData",
        "type": "object"
      },
      "SessionCreate": {
        "properties": {
          "language": {
            "enum": [
              "en",
              "es",
              "ko"
            ],
            "title": "Language",
            "type": "string"
          },
          "source": {
            "enum": [
              "paper",
              "screen",
              "talk"
            ],
            "title": "Source",
            "type": "string"
          },
          "type": {
            "enum": [
              "homework",
              "studying",
              "research",
              "other"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "language",
          "source"
        ],
        "title": "SessionCreate",
        "type": "object"
      },
      "SessionList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/SessionOut"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "SessionList",
        "type": "object"
      },
      "SessionOut": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "language": {
            "enum": [
              "en",
              "es",
              "ko"
            ],
            "title": "Language",
            "type": "string"
          },
          "last_activity_at": {
            "format": "date-time",
            "title": "Last Activity At",
            "type": "string"
          },
          "source": {
            "enum": [
              "paper",
              "screen",
              "talk"
            ],
            "title": "Source",
            "type": "string"
          },
          "subject": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Subject"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "title_source": {
            "anyOf": [
              {
                "enum": [
                  "ai",
                  "student"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title Source"
          },
          "type": {
            "enum": [
              "homework",
              "studying",
              "research",
              "other"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "title_source",
          "subject",
          "type",
          "language",
          "source",
          "created_at",
          "last_activity_at"
        ],
        "title": "SessionOut",
        "type": "object"
      },
      "SessionPatch": {
        "description": "Changes only the fields that are sent. ``null`` clears the title or the subject.",
        "properties": {
          "language": {
            "enum": [
              "en",
              "es",
              "ko"
            ],
            "title": "Language",
            "type": "string"
          },
          "subject": {
            "anyOf": [
              {
                "maxLength": 40,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Subject"
          },
          "title": {
            "anyOf": [
              {
                "maxLength": 80,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "type": {
            "enum": [
              "homework",
              "studying",
              "research",
              "other"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "title": "SessionPatch",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "DeviceToken": {
        "description": "The token from POST /v1/devices.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Tassel",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/devices": {
      "post": {
        "description": "Creates a learner and their device. The token in the response is never shown again.",
        "operationId": "register_device_v1_devices_post",
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceRegistration"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Register Device",
        "tags": [
          "devices"
        ]
      }
    },
    "/v1/health": {
      "get": {
        "operationId": "health_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/me": {
      "get": {
        "operationId": "me_v1_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "DeviceToken": []
          }
        ],
        "summary": "Me",
        "tags": [
          "devices"
        ]
      }
    },
    "/v1/sessions": {
      "get": {
        "operationId": "list_sessions_v1_sessions_get",
        "parameters": [
          {
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "default": "recent",
              "enum": [
                "recent",
                "created",
                "topic"
              ],
              "title": "Sort",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Q"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionList"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "DeviceToken": []
          }
        ],
        "summary": "List Sessions",
        "tags": [
          "sessions"
        ]
      },
      "post": {
        "operationId": "create_session_v1_sessions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "DeviceToken": []
          }
        ],
        "summary": "Create Session",
        "tags": [
          "sessions"
        ]
      }
    },
    "/v1/sessions/{session_id}": {
      "delete": {
        "operationId": "delete_session_v1_sessions__session_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Session Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "DeviceToken": []
          }
        ],
        "summary": "Delete Session",
        "tags": [
          "sessions"
        ]
      },
      "get": {
        "operationId": "get_session_v1_sessions__session_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Session Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "DeviceToken": []
          }
        ],
        "summary": "Get Session",
        "tags": [
          "sessions"
        ]
      },
      "patch": {
        "operationId": "patch_session_v1_sessions__session_id__patch",
        "parameters": [
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Session Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionPatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "DeviceToken": []
          }
        ],
        "summary": "Patch Session",
        "tags": [
          "sessions"
        ]
      }
    },
    "/v1/sessions/{session_id}/voice/offer": {
      "patch": {
        "operationId": "patch_ice_v1_sessions__session_id__voice_offer_patch",
        "parameters": [
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Session Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IcePatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "404": {
            "description": "Session or peer connection not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "DeviceToken": []
          }
        ],
        "summary": "Patch Ice",
        "tags": [
          "voice"
        ]
      },
      "post": {
        "operationId": "offer_v1_sessions__session_id__voice_offer_post",
        "parameters": [
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Session Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OfferBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OfferAnswer"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Session not found"
          },
          "409": {
            "description": "Peer connection ended or unknown"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "description": "Voice unavailable"
          }
        },
        "security": [
          {
            "DeviceToken": []
          }
        ],
        "summary": "Offer",
        "tags": [
          "voice"
        ]
      }
    },
    "/v1/voice/ice-servers": {
      "get": {
        "operationId": "ice_servers_v1_voice_ice_servers_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IceServersOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "DeviceToken": []
          }
        ],
        "summary": "Ice Servers",
        "tags": [
          "voice"
        ]
      }
    }
  }
}
