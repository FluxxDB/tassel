  "info": {
    "title": "Tassel",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/devices": {
      "post": {
        "description": "Creates a learner and their device. The token in the response is never shown again.",
        "operationId": "register_device_v1_devices_post",
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceRegistration"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Register Device",
        "tags": [
          "devices"
        ]
      }
    },
    "/v1/health": {
      "get": {
        "operationId": "health_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/learner/memory": {
      "get": {
        "operationId": "get_memory_v1_learner_memory_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemoryOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "DeviceToken": []
          }
        ],
        "summary": "Get Memory",
        "tags": [
          "memory"
        ]
      },
      "patch": {
        "operationId": "patch_memory_v1_learner_memory_patch",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MemoryPatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemoryOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "description": "Memory changed; reload before saving"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "DeviceToken": []
          }
        ],
        "summary": "Patch Memory",
        "tags": [
          "memory"
        ]
