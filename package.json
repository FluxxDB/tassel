{
  "name": "tassel",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node -e \"console.error('dev: not implemented yet (Task 15)'); process.exit(1)\"",
    "test": "pnpm -r test",
    "check": "biome check . && pnpm -r typecheck && node scripts/check-no-frames.mjs",
    "e2e": "node -e \"console.error('e2e: not implemented yet (Task 15)'); process.exit(1)\"",
    "gen:api": "uv run --directory services/server python -m tassel.scripts.export_openapi && pnpm --filter @tassel/shared exec openapi-typescript src/api/openapi.json -o src/api/schema.d.ts",
    "check:api": "node scripts/check-api.mjs",
    "check:i18n": "node packages/shared/scripts/check-i18n.ts",
    "build:native": "node scripts/native.mjs build",
    "test:native": "node scripts/native.mjs test",
    "gen:paper-clip": "node packages/paper-synth/scripts/gen-clip.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "cross-spawn": "^7.0.6",
    "openapi-typescript": "^7.13.0"
  }
}
