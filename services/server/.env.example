# Tassel's voice settings. Copy this file to services/server/.env and fill it in.
#
# The file holds voice settings only: the provider keys and the tutor's voice ids. It stays on the
# server: it is git-ignored, never shipped in the desktop app, and its keys never reach the app,
# its requests or the logs. Empty values count as unset.

# fake | live | auto. auto runs each provider live as soon as its key below is filled in.
TASSEL_PROVIDERS=auto
# Per-provider overrides, same values: TASSEL_STT_PROVIDER, TASSEL_LLM_PROVIDER,
# TASSEL_TTS_PROVIDER, TASSEL_TITLES_PROVIDER.

# Deepgram: speech to text (Flux for English and Spanish, Nova-3 for Korean).
DEEPGRAM_API_KEY=
# OpenRouter: the tutor's replies and the session titles, served by Cerebras.
OPENROUTER_API_KEY=
# ElevenLabs: the tutor's voice.
ELEVENLABS_API_KEY=

# The tutor's ElevenLabs voice id per session language. Live speech needs all three.
TASSEL_VOICE_EN=
TASSEL_VOICE_ES=
TASSEL_VOICE_KO=
