# Voice settings only; never shipped in the desktop app.
TASSEL_PROVIDERS=auto
# Overrides: TASSEL_STT_PROVIDER, TASSEL_LLM_PROVIDER, TASSEL_TTS_PROVIDER, TASSEL_TITLES_PROVIDER
# LLM override: auto | openrouter | openai | fake
# auto prefers OpenRouter; Task 6 handles credit/refusal fallback to OpenAI.
DEEPGRAM_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
# Optional voice overrides; blank uses Matilda (XrExE9yKIg1WjnnlVkGX).
# Korean can use a native voice override when one is selected.
TASSEL_VOICE_EN=
TASSEL_VOICE_ES=
TASSEL_VOICE_KO=

# Speech model: eleven_multilingual_v2 | eleven_v4_turbo (restart backend to switch).
# v4 Turbo uses Text-to-Dialogue; legacy speed/style settings apply to older TTS models.
TASSEL_TTS_MODEL=eleven_multilingual_v2
